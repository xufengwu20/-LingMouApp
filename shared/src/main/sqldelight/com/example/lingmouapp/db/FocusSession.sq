-- 专注会话：进入专注模式到离开之间的一段区间
CREATE TABLE FocusSession (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    startedAt INTEGER NOT NULL,
    endedAt INTEGER NOT NULL,
    durationMs INTEGER NOT NULL,
    -- 这段会话里累计的分心次数（与 DistractionRecord 对应）
    distractionCount INTEGER NOT NULL DEFAULT 0,
    -- 会话结束时生成的学习笔记，可能还没有
    noteId INTEGER
);

selectAll:
SELECT *
FROM FocusSession
ORDER BY startedAt DESC;

latest:
SELECT *
FROM FocusSession
ORDER BY startedAt DESC
LIMIT 1;

insert:
INSERT INTO FocusSession(startedAt, endedAt, durationMs, distractionCount, noteId)
VALUES (?, ?, ?, ?, ?);

attachNote:
UPDATE FocusSession
SET noteId = ?
WHERE id = ?;

deleteById:
DELETE FROM FocusSession
WHERE id = ?;

deleteAll:
DELETE FROM FocusSession;
